#!/usr/bin/env python3
"""Run the shipped adapters and keep their committed results current: refresh, check, readmes,
reproduce. The logic, usage and exit statuses are in tools/reproduce.py, where the tests measure
them. Run it with the suite's environment: uv run python scripts/reproduce-results <command>."""

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

from tools.reproduce import main

if __name__ == "__main__":
    sys.exit(main())
