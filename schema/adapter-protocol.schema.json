{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bakobo/keri-conformance-suite/schema/adapter-protocol.schema.json",
  "title": "Adapter protocol, version 1",
  "description": "Every request the runner sends and every response an adapter may send. Validate against #/$defs/request or #/$defs/response. See docs/adapter-protocol.md.",
  "$defs": {
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "protocol"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "hello"
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "stream"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "cesr.parse"
            },
            "stream": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "code",
            "raw",
            "domain"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "cesr.encode"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "raw": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "domain": {
              "enum": [
                "text",
                "binary"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "perspective",
            "messages"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "keri.process"
            },
            "perspective": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "validator"
                }
              }
            },
            "messages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stream",
                  "source"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "op",
            "event",
            "seeds"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "keri.emit"
            },
            "event": {
              "type": "object"
            },
            "seeds": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            }
          }
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "result"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "#/$defs/result_hello"
                },
                {
                  "$ref": "#/$defs/result_decoded"
                },
                {
                  "$ref": "#/$defs/result_rejected"
                },
                {
                  "$ref": "#/$defs/result_encoded"
                },
                {
                  "$ref": "#/$defs/result_processed"
                },
                {
                  "$ref": "#/$defs/result_emitted"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "error"
          ],
          "properties": {
            "id": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "null only when the request could not be read at all"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "harness",
                    "unsupported"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "result_hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "adapter",
        "implementation",
        "operations",
        "features"
      ],
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "commit"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "cesr.parse",
              "cesr.encode",
              "keri.process",
              "keri.emit"
            ]
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          }
        },
        "composes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          }
        }
      }
    },
    "result_decoded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end",
                  "code",
                  "raw"
                ],
                "properties": {
                  "kind": {
                    "const": "primitive"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "code": {
                    "type": "string"
                  },
                  "raw": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end",
                  "code",
                  "raw",
                  "index"
                ],
                "properties": {
                  "kind": {
                    "const": "indexed"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "code": {
                    "type": "string"
                  },
                  "raw": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ondex": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end",
                  "code",
                  "size",
                  "group_end"
                ],
                "properties": {
                  "kind": {
                    "const": "counter"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "code": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "genus": {
                    "type": "string"
                  },
                  "gvrsn": {
                    "type": "string"
                  },
                  "group_end": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "start",
                  "end",
                  "proto",
                  "version",
                  "serialization",
                  "size"
                ],
                "properties": {
                  "kind": {
                    "const": "message"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "proto": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "serialization": {
                    "enum": [
                      "JSON",
                      "CBOR",
                      "MGPK"
                    ]
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "result_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reject"
      ],
      "properties": {
        "reject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string"
            }
          }
        }
      }
    },
    "result_encoded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoded"
      ],
      "properties": {
        "encoded": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    "result_processed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispositions",
        "key_states"
      ],
      "properties": {
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "initial",
              "final"
            ],
            "properties": {
              "initial": {
                "enum": [
                  "accepted",
                  "pending",
                  "rejected",
                  "duplicitous"
                ]
              },
              "final": {
                "enum": [
                  "accepted",
                  "pending",
                  "rejected",
                  "duplicitous",
                  "superseded"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "key_states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/key_state"
          }
        }
      }
    },
    "result_emitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    "key_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sn",
        "said",
        "keys",
        "kt",
        "ndigs",
        "nt",
        "wits",
        "bt",
        "delegator"
      ],
      "properties": {
        "sn": {
          "type": "integer",
          "minimum": 0
        },
        "said": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kt": {
          "$ref": "#/$defs/threshold"
        },
        "ndigs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nt": {
          "$ref": "#/$defs/threshold"
        },
        "wits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bt": {
          "type": "string"
        },
        "delegator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "threshold": {
      "description": "A threshold as the implementation holds it: a hex or decimal integer string, or weighted clauses as (nested) lists of fraction strings. The runner normalizes before comparing.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
