{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bakobo/keri-conformance-suite/schema/adapter-protocol.schema.json",
  "title": "Adapter protocol, version 1",
  "description": "Every request the runner sends and every response an adapter may send. Validate against #/$defs/request or #/$defs/response. See docs/adapter-protocol.md.",
  "$defs": {
    "request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "protocol",
            "supported"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "hello"
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            },
            "supported": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "stream"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "cesr.parse"
            },
            "stream": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "code",
            "raw",
            "domain"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "cesr.encode"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "raw": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "domain": {
              "enum": [
                "text",
                "binary"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "perspective",
            "messages"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "keri.process"
            },
            "perspective": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "validator"
                }
              }
            },
            "messages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "stream",
                  "source"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "event",
            "seeds"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "keri.emit"
            },
            "event": {
              "type": "object"
            },
            "seeds": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "perspective",
            "kels",
            "registry",
            "schemas",
            "acdcs",
            "presented"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "acdc.verify"
            },
            "perspective": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "validator"
                }
              }
            },
            "kels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stream",
                  "source"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            },
            "registry": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stream"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                }
              }
            },
            "schemas": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            },
            "acdcs": {
              "type": "array",
              "maxItems": 15,
              "items": {
                "type": "object",
                "required": [
                  "stream"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  }
                }
              },
              "description": "The far nodes of the presented ACDC's provenance DAG. The DAG holds at most 16 ACDCs, the presented one included."
            },
            "presented": {
              "type": "object",
              "required": [
                "stream"
              ],
              "properties": {
                "stream": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                }
              }
            },
            "expect_schema": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "op",
            "perspective",
            "kels",
            "messages"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "op": {
              "const": "exn.verify"
            },
            "perspective": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "validator"
                }
              }
            },
            "kels": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stream",
                  "source"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            },
            "messages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "stream",
                  "source"
                ],
                "properties": {
                  "stream": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Requests are open: an adapter must ignore fields it does not recognise, so later protocol versions can add fields without breaking version-1 adapters."
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "result"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "#/$defs/result_hello"
                },
                {
                  "$ref": "#/$defs/result_decoded"
                },
                {
                  "$ref": "#/$defs/result_rejected"
                },
                {
                  "$ref": "#/$defs/result_accepted"
                },
                {
                  "$ref": "#/$defs/result_encoded"
                },
                {
                  "$ref": "#/$defs/result_processed"
                },
                {
                  "$ref": "#/$defs/result_emitted"
                },
                {
                  "$ref": "#/$defs/result_verified"
                },
                {
                  "$ref": "#/$defs/result_exchanged"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "error"
          ],
          "properties": {
            "id": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "null only when the request could not be read at all"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "message"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "harness",
                    "unsupported"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "result_hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "adapter",
        "implementation",
        "operations",
        "features"
      ],
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "commit"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "cesr.parse",
              "cesr.encode",
              "keri.process",
              "keri.emit"
            ]
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          }
        },
        "composes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          }
        }
      }
    },
    "result_decoded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "result_rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reject"
      ],
      "properties": {
        "reject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string"
            }
          }
        }
      }
    },
    "result_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "description": "A cesr.parse summary: the implementation accepted the stream and consumed this many bytes of it, without item detail. It is a complete answer to a case whose assertions are all rejections. A case with a decoded assertion is sent only to an adapter that declares cesr.item-extents, and a summary given to such a case fails it as malformed. The runner also requires consumed to be no larger than the request's stream, which this schema cannot express.",
      "properties": {
        "accepted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumed"
          ],
          "properties": {
            "consumed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "result_encoded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoded"
      ],
      "properties": {
        "encoded": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    "result_processed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispositions",
        "key_states"
      ],
      "properties": {
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "initial",
              "final",
              "trunk"
            ],
            "description": "A message's readings, defined in docs/design.md under KERI: initial and final are seen, or the most specific refinement of not seen, at quiescence after its own delivery and after the last message; trunk is whether it is a key event on the trunk at the end, which only a finally seen message can be.",
            "properties": {
              "initial": {
                "enum": [
                  "seen",
                  "pending",
                  "rejected",
                  "duplicitous"
                ]
              },
              "final": {
                "enum": [
                  "seen",
                  "pending",
                  "rejected",
                  "duplicitous"
                ]
              },
              "trunk": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            },
            "if": {
              "properties": {
                "trunk": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "final": {
                  "const": "seen"
                }
              }
            }
          }
        },
        "key_states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/key_state"
          }
        }
      }
    },
    "result_emitted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream"
      ],
      "properties": {
        "stream": {
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        }
      }
    },
    "key_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sn",
        "said",
        "keys",
        "kt",
        "ndigs",
        "nt",
        "wits",
        "bt",
        "delegator"
      ],
      "properties": {
        "sn": {
          "type": "integer",
          "minimum": 0
        },
        "said": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kt": {
          "$ref": "#/$defs/threshold"
        },
        "ndigs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nt": {
          "$ref": "#/$defs/threshold"
        },
        "wits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bt": {
          "type": "string",
          "pattern": "^(0x)?[0-9a-f]{1,64}$"
        },
        "delegator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "threshold": {
      "description": "A threshold as the implementation holds it, exactly the forms the runner normalizes: a hexadecimal integer string with an optional 0x prefix, as KERI encodes numeric thresholds; or weighted clauses, either one clause as a non-empty list of fraction strings or several as a non-empty list of such lists, never mixed. A fraction string is a non-negative integer of at most 64 digits, optionally over a non-zero denominator of at most 64 digits, with no spaces or signs. The runner normalizes both sides before comparing.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0x)?[0-9a-fA-F]{1,64}$"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,64}(/(?=[0-9]{1,64}$)[0-9]*[1-9][0-9]*)?$"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{1,64}(/(?=[0-9]{1,64}$)[0-9]*[1-9][0-9]*)?$"
            }
          }
        }
      ]
    },
    "item": {
      "description": "One decoded item, as the adapter protocol defines it for a cesr.parse result. Closed and kind-specific, and identical in the case schema and the adapter-protocol schema, so that every expected item a case states is one a conforming adapter can report.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "code",
            "raw"
          ],
          "properties": {
            "kind": {
              "const": "primitive"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "code": {
              "type": "string"
            },
            "raw": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "code",
            "raw",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "indexed"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "code": {
              "type": "string"
            },
            "raw": {
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "ondex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "code",
            "size",
            "group_end"
          ],
          "properties": {
            "kind": {
              "const": "counter"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "code": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "group_end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "code",
            "genus",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "genus"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "code": {
              "type": "string",
              "pattern": "^-_[A-Za-z0-9_-]{6}$"
            },
            "genus": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{3}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2,}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end",
            "proto",
            "version",
            "serialization",
            "size"
          ],
          "properties": {
            "kind": {
              "const": "message"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "proto": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "serialization": {
              "enum": [
                "JSON",
                "CBOR",
                "MGPK"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "registry_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rd",
        "n",
        "d",
        "td",
        "ts"
      ],
      "description": "The verified head of the registry the presented ACDC's top-level rd names (docs/design.md, Registry state): the registry's SAID, and the sequence number, SAID, transaction ACDC SAID and state of the last event in the verified chain. td and ts are both null when a blinded state was not disclosed, and otherwise both given.",
      "properties": {
        "rd": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "d": {
          "type": "string",
          "minLength": 1
        },
        "td": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "ts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "td": {
              "type": "null"
            },
            "ts": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "td": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            }
          }
        }
      ]
    },
    "result_verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "registry",
        "edges"
      ],
      "description": "An acdc.verify result (docs/adapter-protocol.md). Each edge is listed once; the runner refuses an edge listed twice, which this schema cannot express.",
      "properties": {
        "verdict": {
          "enum": [
            "valid",
            "invalid",
            "incomplete"
          ]
        },
        "reason": {
          "type": "string"
        },
        "registry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/registry_state"
            }
          ]
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "near",
              "path",
              "n",
              "valid"
            ],
            "properties": {
              "near": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^e(\\.[^.]+)+$",
                "description": "The chain of field labels from the near node's top-level e field, joined by full stops, such as e.le."
              },
              "n": {
                "type": "string",
                "minLength": 1
              },
              "valid": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "result_exchanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdicts"
      ],
      "description": "An exn.verify result: one entry per message, in order, each read at quiescence after its own delivery and after the last message.",
      "properties": {
        "verdicts": {
