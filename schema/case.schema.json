{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bakobo/keri-conformance-suite/schema/case.schema.json",
  "title": "Conformance case",
  "description": "One case: a fixed input and the assertions an implementation's report must satisfy. See docs/design.md, Cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "status",
    "profile",
    "targets",
    "operation",
    "input",
    "assertions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(CESR|KERI|ACDC|IPEX)-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "draft",
        "disputed",
        "deprecated"
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wire",
        "features"
      ],
      "properties": {
        "wire": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          }
        }
      }
    },
    "operation": {
      "enum": [
        "cesr.parse",
        "cesr.encode",
        "keri.process",
        "keri.emit"
      ]
    },
    "input": {
      "type": "object"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "decoded"
                  },
                  "expected": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/item"
                    }
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "rejected"
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "encoded"
                  },
                  "expected": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "message",
                  "phase",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "disposition"
                  },
                  "message": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "phase": {
                    "enum": [
                      "initial",
                      "final"
                    ]
                  },
                  "expected": {
                    "enum": [
                      "seen",
                      "not-seen",
                      "pending",
                      "rejected",
                      "duplicitous"
                    ],
                    "description": "seen: accepted into the validator's KEL. not-seen: any other reading. pending, rejected and duplicitous: refinements of not-seen, graded only where a clause states them (docs/design.md, KERI)."
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "message",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "trunk"
                  },
                  "message": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "expected": {
                    "type": "boolean",
                    "description": "Whether the message is a key event on the trunk at quiescence after the last message. A superseded event is finally seen and off the trunk."
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "if_seen",
                  "aid",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "key_state"
                  },
                  "if_seen": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The message this assertion is conditioned on: it applies only if that message's final reading is seen, and is otherwise not-applicable. It keeps its own clause's level."
                  },
                  "aid": {
                    "type": "string"
                  },
                  "expected": {
                    "$ref": "#/$defs/key_state"
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "emitted_body"
                  },
                  "expected": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "signatures_verify"
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "check",
                  "level",
                  "expected"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^a[0-9]+$"
                  },
                  "level": {
                    "enum": [
                      "MUST",
                      "SHOULD",
                      "MAY",
                      "INTEROP"
                    ]
                  },
                  "clause": {
                    "$ref": "#/$defs/clause"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "description": "For INTEROP assertions: the implementation behaviour the assertion rests on."
                  },
                  "note": {
                    "type": "string"
                  },
                  "check": {
                    "const": "attachments_equivalent"
                  },
                  "expected": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "spec_conflicts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/spec_conflict"
                    },
                    "description": "Other text in the specification that states a different rule from the cited clause. Informative: the assertion keeps its clause's level."
                  },
                  "inferred_from": {
                    "$ref": "#/$defs/inference",
                    "description": "For an assertion graded SHOULD because the consumer obligation it tests is inferred from a producer-side clause, the clause and the inference."
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "level": {
                      "enum": [
                        "MUST",
                        "SHOULD",
                        "MAY"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "clause"
                  ],
                  "not": {
                    "required": [
                      "basis"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "level": {
                      "const": "INTEROP"
                    }
                  }
                },
                "then": {
                  "required": [
                    "basis"
                  ],
                  "not": {
                    "required": [
                      "clause"
                    ]
                  }
                }
              }
            ]
          },
          {
            "if": {
              "required": [
                "inferred_from"
              ]
            },
            "then": {
              "properties": {
                "level": {
                  "const": "SHOULD"
                }
              }
            }
          }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "generator",
        "reference"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "implementation",
                "commit"
              ],
              "properties": {
                "implementation": {
                  "type": "string"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$"
                }
              }
            }
          ]
        }
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clauses",
        "summary",
        "raised_at"
      ],
      "properties": {
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "raised_at": {
          "type": "string"
        }
      }
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^(CESR|KERI|ACDC|IPEX)-[0-9]{4}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "cesr.parse"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stream"
            ],
            "properties": {
              "stream": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "cesr.encode"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "raw",
              "domain"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "raw": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              },
              "domain": {
                "enum": [
                  "text",
                  "binary"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "keri.process"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "perspective",
              "messages"
            ],
            "properties": {
              "perspective": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "const": "validator"
                  }
                }
              },
              "messages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "stream",
                    "source"
                  ],
                  "properties": {
                    "stream": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{2})*$"
                    },
                    "source": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "keri.emit"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "seeds"
            ],
            "properties": {
              "event": {
                "type": "object"
              },
              "seeds": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "disputed"
          }
        }
      },
      "then": {
        "required": [
          "dispute"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        }
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "cesr.parse"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "items": {
              "properties": {
                "check": {
                  "enum": [
                    "decoded",
                    "rejected"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "cesr.encode"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "items": {
              "properties": {
                "check": {
                  "enum": [
                    "encoded"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "keri.process"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "items": {
              "properties": {
                "check": {
                  "enum": [
                    "disposition",
                    "trunk",
                    "key_state"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "keri.emit"
          }
        }
      },
      "then": {
        "properties": {
          "assertions": {
            "items": {
              "properties": {
                "check": {
                  "enum": [
                    "emitted_body",
                    "signatures_verify",
                    "attachments_equivalent"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "section",
        "url",
        "commit"
      ],
      "properties": {
        "spec": {
          "enum": [
            "cesr",
            "keri",
            "acdc",
            "ipex"
          ]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "quote": {
          "type": "string",
