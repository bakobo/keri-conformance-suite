
# Rendered doc artifacts are derived from the markdown next to them; the
# markdown is the only tracked source of truth. Render into docs/, never the root.
# See dev/standards/repo-layout.md, "Rendered doc artifacts".
docs/**/*.pdf
docs/**/*.html

# The documentation site: its assembled source and the built HTML (scripts/site-source,
# zensical.toml). Both are generated at build time and never committed.
_site/

# Python
.venv/
__pycache__/
.coverage
coverage.json
.pytest_cache/
.ruff_cache/
