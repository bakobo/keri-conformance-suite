   "id": "ACDC-0196",
   "key": "SR-01",
   "title": "Issuer rotation after the anchor",
   "description": "As SV-01, but after anchoring the registry update that issues the credential, the issuer rotates its keys. The anchor was signed under the key state at its own event, so the rotation does not undo it. A sedi-1 verifier should find it valid.",
   "base": "SR-01",
   "choices": [
    "seal-shape",
    "registry-head",
    "valid-is-interop"
   ],
   "triage": "None: an acceptance.",
   "expect": []
  },
  {
   "id": "ACDC-0197",
   "key": "SR-02",
   "title": "Anchor signed with a rotated-out key",
   "description": "As SR-01, but the issuer rotates before the interaction that anchors the update, and signs that interaction with the key the rotation retired. That interaction is not in the issuer's verified KEL, so the update has no anchor the verifier can confirm, and a sedi-1 verifier should find it incomplete.",
   "base": "SR-02",
   "choices": [
    "seal-shape",
    "registry-evidence",
    "unresolved-grading"
   ],
   "triage": "Accepting it accepts an issuance anchored with a key the issuer has rotated away from, which is what pre-rotation exists to stop.",
   "expect": [
    "A incomplete/bup-anchor"
   ],
   "pair": "SR-01"
  }
