 "cases": [
  {
   "id": "ACDC-0208",
   "key": "SD-01",
   "title": "Issued directly under a schema that forbids rd",
   "description": "A credential whose schema closes its top level without an rd, as SEDI's identity assurance receipt does, issued with no registry: the issuer anchors the digest seal {d} of its SAID in its KEL (ACDC line 1667). A sedi-1 verifier should find it valid.",
   "base": "SD-01",
   "choices": [
    "direct-issuance",
    "valid-is-interop"
   ],
   "triage": "None: an acceptance.",
   "expect": []
  },
  {
   "id": "ACDC-0209",
   "key": "SD-02",
   "title": "Directly issued, with no seal",
   "description": "As SD-01, but the issuer's KEL carries no seal of the credential, so nothing the verifier holds commits the issuer to it. A sedi-1 verifier should find it incomplete.",
   "base": "SD-02",
   "choices": [
    "direct-issuance",
    "unresolved-grading"
   ],
   "triage": "Accepting it accepts a credential its issuer never anchored, which a holder of the issuer's compromised keys could have made.",
   "expect": [
    "A incomplete/direct-anchor"
   ],
   "pair": "SD-01"
  },
  {
   "id": "ACDC-0210",
   "key": "SD-03",
   "title": "Directly issued under a seal of another shape",
   "description": "As SD-01, but the seal naming the credential's SAID carries an s as well, the shape of a registry event's seal, which is not the digest seal direct issuance uses. A sedi-1 verifier should find it invalid.",
   "base": "SD-03",
   "choices": [
    "direct-issuance"
   ],
   "triage": "Accepting it lets a seal written for one purpose stand for another.",
   "expect": [
    "A invalid/direct-seal"
   ],
   "pair": "SD-01"
  },
  {
   "id": "ACDC-0211",
   "key": "SD-04",
   "title": "No rd under a schema that admits one",
   "description": "As SD-01, but under a schema whose top level is open, so the credential could have named a registry and did not. Only a schema that forbids rd is issued directly, so the digest seal does not commit it, and a sedi-1 verifier should find it invalid.",
   "base": "SD-04",
   "choices": [
    "direct-issuance"
   ],
   "triage": "Accepting it lets an issuer put a revocable credential beyond revocation by leaving out its rd.",
   "expect": [
    "A invalid/no-registry"
   ],
   "pair": "SD-01"
  }
 ]
}
