  {
   "id": "ACDC-0157",
   "key": "SN-01",
   "title": "Credential in the 2.00 forms",
   "description": "A credential with a 2.00 version string, the 2.00 field set and its registry a blindable 2.00 registry, presented expanded. A sedi-1 verifier should find it valid.",
   "base": "SN-01",
   "choices": [
    "no-1x",
    "valid-is-interop"
   ],
   "triage": "None: an acceptance.",
   "expect": []
  },
  {
   "id": "ACDC-0158",
   "key": "SN-02",
   "title": "1.x version string over a 2.00 body",
   "description": "As SN-01, but the credential's version string is the 1.x form, ACDC10JSON with its size in six hex digits, over the same 2.00 body. Under sedi-1 a 1.x version string is never valid. A sedi-1 verifier should find it invalid.",
   "base": "SN-02",
   "choices": [
    "no-1x"
   ],
   "triage": "Accepting it lets a credential be re-presented in a form its 2.00 registry may not govern.",
   "expect": [
    "presented invalid/unframeable"
   ],
   "pair": "SN-01"
  },
  {
   "id": "ACDC-0159",
   "key": "SN-03",
   "title": "1.x field set under a 2.00 version string",
   "description": "As SN-01, but the credential carries keripy 1.x's field set, ri for rd and no t, under a 2.00 version string sized to it, with its SAID recomputed over that body so that only the field set is wrong. Under sedi-1 a 1.x field set is never valid. A sedi-1 verifier should find it invalid.",
   "base": "SN-03",
   "choices": [
    "no-1x"
   ],
   "triage": "Accepting it lets a credential be re-presented in a form its 2.00 registry may not govern.",
   "expect": [
    "A invalid/field-order",
    "A invalid/no-registry"
   ],
   "pair": "SN-01"
  }
 ]
