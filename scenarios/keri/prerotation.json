          ],
          "nt": "1"
        },
        {
          "name": "rot1",
          "aid": "A",
          "t": "rot",
          "keys": [
            "a1",
            "b1"
          ],
          "kt": "1",
          "next": [
            "a2",
            "b2"
          ],
          "nt": "1"
        }
      ],
      "messages": [
        {
          "event": "icp",
          "sigs": [
            "a0"
          ],
          "expect": [
            "6/accepted",
            "6/accepted"
          ]
        },
        {
          "event": "rot1",
          "sigs": [
            {
              "key": "a1",
              "ondex": 1
            }
          ],
          "expect": [
            "4/signing-threshold",
            "4/signing-threshold"
          ]
        }
      ],
      "key_state": {
        "A": {
          "clause": "prerotation"
        }
      }
    },
