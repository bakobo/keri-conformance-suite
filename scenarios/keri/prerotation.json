{
  "profile": "keri-v1.0.1",
  "cases": [
    {
      "id": "KERI-0021",
      "key": "KS-25",
      "title": "Rotation that breaks the pre-rotation commitment",
      "description": "An accepted inception committing to the digest of a1, then a rotation to an unrelated key x, signed by x. The rotation's keys include no subset of the prior next keys, so a validator must not accept it (lines 1262 and 1494), and its key state stays the inception's.",
      "events": [
        {
          "name": "icp",
          "aid": "A",
          "t": "icp",
          "keys": [
            "a0"
          ],
          "next": [
            "a1"
          ]
        },
        {
          "name": "rot1",
          "aid": "A",
          "t": "rot",
          "keys": [
            "x"
          ],
          "next": [
            "x2"
          ]
        }
      ],
      "messages": [
        {
          "event": "icp",
          "sigs": [
            "a0"
          ],
          "expect": [
            "6/accepted",
            "6/accepted"
          ]
        },
        {
          "event": "rot1",
          "sigs": [
            {
              "key": "x",
              "code": "A"
            }
          ],
          "expect": [
            "4/pre-rotation",
            "4/pre-rotation"
          ]
        }
      ],
      "key_state": {
        "A": {
          "clause": "prerotation"
        }
      }
    },
    {
      "id": "KERI-0022",
      "key": "KS-26",
      "title": "Rotation signature that names the wrong prior next digest",
      "description": "An inception committing to the digests of a1 and b1 with next threshold 1, then a rotation to [a1, b1] signed only by a1 with a dual-indexed signature whose prior-next index (ondex) is 1, the position of b1's digest. That signature does not satisfy the prior next threshold, so a validator must not accept the rotation; as a threshold shortfall it should keep it.",
      "events": [
        {
          "name": "icp",
          "aid": "A",
          "t": "icp",
          "keys": [
            "a0"
          ],
