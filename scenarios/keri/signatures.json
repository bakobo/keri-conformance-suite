      "id": "KERI-0005",
      "key": "KS-06",
      "title": "Signing threshold completed by a second copy",
      "description": "The inception of KS-05 arrives signed by one key, then again signed by another. Together the two copies satisfy the threshold, so a validator that kept the first copy, as line 1266 says it should, accepts the event. The safety half, graded at MUST without keri.escrow, is the companion case KS-06s.",
      "events": [
        {
          "name": "icp",
          "aid": "A",
          "t": "icp",
          "keys": [
            "a0",
            "b0",
            "c0"
          ],
          "kt": "2",
          "next": [
            "a1",
            "b1",
            "c1"
          ],
          "nt": "2"
        }
      ],
      "messages": [
        {
          "event": "icp",
          "sigs": [
            "a0"
          ],
          "expect": [
            "4/signing-threshold",
            "6/already-seen"
          ]
        },
        {
          "event": "icp",
          "sigs": [
            "c0"
          ],
          "expect": [
            "6/accepted",
            "6/accepted"
          ]
        }
      ],
      "companion": {
        "id": "KERI-0054",
        "key": "KS-06s",
        "title": "Signing threshold completed by a second copy: safety half",
        "description": "KS-06's deliveries, graded only at MUST and without needing keri.escrow: the first copy alone must not be accepted, and if the event is accepted its key state is the inception's."
      }
    },
