          "aid": "A",
          "t": "icp",
          "keys": [
            "a0"
          ],
          "next": [
            "a1"
          ],
          "tamper": {
            "i": "other-prefix"
          }
        }
      ],
      "messages": [
        {
          "event": "icp",
          "sigs": [
            "a0"
          ],
          "expect": [
            "1/d-i",
            "1/d-i"
          ]
        }
      ]
    },
