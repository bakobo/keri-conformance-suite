 "cases": [
  {
   "id": "ACDC-0201",
   "key": "SX-01",
   "title": "A SEDI core credential in the 1.x forms",
   "description": "SEDI core, issued to the holder in the 1.x forms under the 1.x profile of its schema (interop/two-wallets/schemas/sedi-core-1x.schema.json), with no a.dt, and in a vcp/iss registry anchored in the issuer's KEL. A keripy 1.x verifier finds it valid.",
   "fixture": "core",
   "presented": "core",
   "expected": "valid",
   "basis": "its Verifier saves the credential: the registry issues it and it validates against the 1.x profile of SEDI core.",
   "triage": "None: an acceptance."
  },
  {
   "id": "ACDC-0202",
   "key": "SX-02",
   "title": "A 1.x credential under SEDI's 2.0 schema shape",
   "description": "As SX-01, but the schema is SEDI core in the KERI 2.0 shape SEDI publishes, which requires rd, e and r and defines t (G17 incompatibility 7). A 1.x body has ri and none of those, so a 1.x wallet cannot hold a SEDI credential without a 1.x profile of the schema. A keripy 1.x verifier refuses it.",
   "fixture": "core-2x",
   "presented": "core",
   "expected": "invalid",
   "basis": "its Verifier refuses the credential: it fails the schema, which requires fields a 1.x body does not have.",
   "triage": "A 1.x verifier that accepts a credential its schema refuses accepts what the issuer never claimed.",
   "pair": "SX-01"
  },
  {
   "id": "ACDC-0203",
   "key": "SX-03",
   "title": "An a.dt the SEDI schema forbids",
   "description": "As SX-01, but the attribute block carries a.dt, which SEDI core's closed attribute section does not name. signify-ts's issue helper inserts a.dt this way (G17 incompatibility 8). A keripy 1.x verifier refuses it.",
   "fixture": "core-dt",
   "presented": "core",
   "expected": "invalid",
   "basis": "its Verifier refuses the credential: a.dt is outside the attribute section the schema closes.",
   "triage": "A verifier that ignores a closed attribute section accepts attributes the schema forbids.",
   "pair": "SX-01"
  },
  {
   "id": "ACDC-0204",
   "key": "SX-04",
   "title": "An a.dt the schema allows",
   "description": "As SX-03, but the schema names dt, so the credential satisfies it. With SX-01, which has no a.dt at all, it shows a 1.x verifier needs a.dt neither present nor absent: Veridian assumes every ACDC has one (G17 incompatibility 11). A keripy 1.x verifier finds it valid.",
   "fixture": "core-dt-allowed",
   "presented": "core",
   "expected": "valid",
   "basis": "its Verifier saves the credential: a.dt is named by the schema and nothing requires it.",
   "triage": "None: an acceptance."
  },
  {
   "id": "ACDC-0205",
   "key": "SX-05",
   "title": "SEDI core's edge section, as SEDI's schema requires it",
   "description": "As SX-07, but the edge section carries its own u, as SEDI core's schema requires of every edge section; both cases use SEDI core's 1.x profile changed only to stop requiring that u, so they differ in nothing else. keripy 1.x reads every label of an edge section except d and o as an edge, so the section's u breaks its edge walk and it never saves the credential. Since SEDI's schema requires the u, a keripy 1.x verifier cannot verify any SEDI credential that carries its edge section.",
   "fixture": "core-agent",
   "presented": "core",
   "expected": "invalid",
   "basis": "its Verifier's edge walk takes the edge section's u for an edge and fails on it (vdr/verifying.py, processCredential), so it never saves the credential.",
   "triage": "A refusal, not an acceptance: no credential a 1.x verifier should refuse is accepted.",
   "pair": "SX-07"
  },
  {
   "id": "ACDC-0206",
   "key": "SX-06",
   "title": "The 1.x copy a 2.00 revocation does not reach",
   "description": "The SX-01 claim's 1.x copy, kept in the 1.x registry it was issued in before migration, issued and not revoked there. The bundle holds only the 1.x forms, which are all a keripy 1.x verifier reads: a revocation of the claim's 2.00 form, as in sedi-1's ACDC-0106, is recorded in a blindable 2.00 registry it never consults, so it finds the 1.x copy valid. Migrating a claim from 1.x to 2.00 therefore needs both forms revoked, unless every 1.x verifier can be expected to see the 2.00 registry (docs/profiles/sedi.md).",
   "fixture": "core-migrated",
   "presented": "core",
   "expected": "valid",
   "basis": "its Verifier saves the credential: nothing in the 1.x registry revokes it.",
   "triage": "A revocation recorded only in the 2.00 registry is invisible to a 1.x verifier, which keeps accepting the claim."
  },
  {
   "id": "ACDC-0207",
   "key": "SX-07",
   "title": "An agent edge with no section u",
   "description": "As SX-01, but with SEDI core's optional edge section: a utahAgent edge, NI2I, to an agent credential the same issuer issued, with the u and d SEDI's schema requires of the edge, and no u of the section's own, under SEDI core's 1.x profile changed only to stop requiring one. With SX-01, which omits the edge section, it shows the edge is optional (G17 incompatibility 10: Veridian treats every edge definition as mandatory). A keripy 1.x verifier finds it valid.",
   "fixture": "core-agent-plain",
   "presented": "core",
   "expected": "valid",
   "basis": "its Verifier saves the credential once the far agent credential is saved and the NI2I edge to it holds.",
   "triage": "None: an acceptance."
  }
 ]
