#!/usr/bin/env python3
"""Refuse a push that mentions anything on the private embargo list (tools/embargo_guard.py).
Enable once per clone with: git config core.hooksPath .githooks"""

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))

from tools.embargo_guard import main  # noqa: E402

sys.exit(main(["--hook"]))
